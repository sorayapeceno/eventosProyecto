<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee
                             http://xmlns.jcp.org/xml/ns/javaee/web-app_4_0.xsd"
         version="4.0">

    <!-- CRMServlet -->
    <servlet>
        <servlet-name>CRMServlet</servlet-name>
        <servlet-class>dam.primero.servlet.crm.CRMServlet</servlet-class>
        <load-on-startup>1</load-on-startup>
    </servlet>
    <servlet-mapping>
        <servlet-name>CRMServlet</servlet-name>
        <url-pattern>/crm/*</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>CRMServlet</servlet-name>
        <url-pattern>/</url-pattern>
    </servlet-mapping>

    <!-- DashBoardsServlet -->
    <servlet>
        <servlet-name>DashBoardsServlet</servlet-name>
        <servlet-class>dam.primero.servlet.dashboards.DashBoardsServlet</servlet-class>
        <load-on-startup>2</load-on-startup>
    </servlet>
    <servlet-mapping>
        <servlet-name>DashBoardsServlet</servlet-name>
        <url-pattern>/dashboards/*</url-pattern>
    </servlet-mapping>

    <!-- VentasServlet -->
    <servlet>
        <servlet-name>VentasServlet</servlet-name>
        <servlet-class>dam.primero.servlet.ventas.VentasServlet</servlet-class>
        <load-on-startup>3</load-on-startup>
    </servlet>
    <servlet-mapping>
        <servlet-name>VentasServlet</servlet-name>
        <url-pattern>/ventas/*</url-pattern>
    </servlet-mapping>

    <!-- AsistenteServlet -->
    <servlet>
        <servlet-name>AsistenteServlet</servlet-name>
        <servlet-class>dam.primero.servlet.ventas.AsistenteServlet</servlet-class>
        <load-on-startup>4</load-on-startup>
    </servlet>
    <servlet-mapping>
        <servlet-name>AsistenteServlet</servlet-name>
        <url-pattern>/asistente/*</url-pattern>
    </servlet-mapping>

    <!-- ProductoServlet -->
    <servlet>
        <servlet-name>ProductoServlet</servlet-name>
        <servlet-class>dam.primero.servlet.ventas.ProductoServlet</servlet-class>
        <load-on-startup>5</load-on-startup>
    </servlet>
    <servlet-mapping>
        <servlet-name>ProductoServlet</servlet-name>
        <url-pattern>/producto/*</url-pattern>
    </servlet-mapping>

    <!-- TicketServlet -->
    <servlet>
        <servlet-name>TicketServlet</servlet-name>
        <servlet-class>dam.primero.servlet.ventas.TicketServlet</servlet-class>
        <load-on-startup>6</load-on-startup>
    </servlet>
    <servlet-mapping>
        <servlet-name>TicketServlet</servlet-name>
        <url-pattern>/ticket/*</url-pattern>
    </servlet-mapping>

    <!-- ParticipantesServlet -->
    <servlet>
        <servlet-name>ParticipantesServlet</servlet-name>
        <servlet-class>dam.primero.servlet.eventos_participantes.ParticipantesServlet</servlet-class>
        <load-on-startup>7</load-on-startup>
    </servlet>
    <servlet-mapping>
        <servlet-name>ParticipantesServlet</servlet-name>
        <url-pattern>/participantes/*</url-pattern>
    </servlet-mapping>

    <!-- LogisticaServlet -->
    <servlet>
        <servlet-name>LogisticaServlet</servlet-name>
        <servlet-class>dam.primero.servlet.logistica.LogisticaServlet</servlet-class>
        <load-on-startup>8</load-on-startup>
    </servlet>
    <servlet-mapping>
        <servlet-name>LogisticaServlet</servlet-name>
        <url-pattern>/logistica/*</url-pattern>
    </servlet-mapping>

    <!-- RelacionesServlet -->
    <servlet>
        <servlet-name>RelacionesServlet</servlet-name>
        <servlet-class>dam.primero.servlet.institucionales.RelacionesServlet</servlet-class>
        <load-on-startup>9</load-on-startup>
    </servlet>
    <servlet-mapping>
        <servlet-name>RelacionesServlet</servlet-name>
        <url-pattern>/relaciones/*</url-pattern>
    </servlet-mapping>

    <!-- Recursos estáticos -->
    <servlet-mapping>
        <servlet-name>default</servlet-name>
        <url-pattern>/CSS/*</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>default</servlet-name>
        <url-pattern>/Fotos/*</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>default</servlet-name>
        <url-pattern>/JS/*</url-pattern>
    </servlet-mapping>

</web-app>